#!/usr/bin/env python3
"""review-comment PATH LINE[-END] [BODY | -] [--old]

Drafts a review comment in the Herdr Review panel open on this checkout.
Nothing is posted: the reviewer keeps, edits or discards every draft.

  PATH      file, relative to the repo root (or absolute)
  LINE-END  line or range, in the new version of the file
  --old     the lines are ones the change deletes (old version's numbers)
  BODY      markdown; "-" or nothing reads it from stdin. For a concrete fix,
            add a ```suggestion block with the replacement lines.
"""
import json, os, re, subprocess, sys, time

argv = sys.argv[1:]
old = "--old" in argv
args = [a for a in argv if a != "--old"]
if len(args) < 2 or args[0] in ("-h", "--help"):
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
path, rng = args[0], args[1]
body = args[2] if len(args) > 2 else "-"
if body == "-":
    body = sys.stdin.read()
body = body.strip()
m = re.fullmatch(r"(\d+)(?:-(\d+))?", rng)
if not m or not body:
    print("review-comment: need a line like 12 or 12-18, and a comment body", file=sys.stderr)
    sys.exit(2)
start, end = int(m.group(1)), int(m.group(2) or m.group(1))
if end < start:
    start, end = end, start

def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True, check=True).stdout.strip()

try:
    top, gitdir = git("rev-parse", "--show-toplevel"), git("rev-parse", "--absolute-git-dir")
except subprocess.CalledProcessError:
    print("review-comment: run it inside the repository being reviewed", file=sys.stderr)
    sys.exit(1)
full = os.path.abspath(path)
if not os.path.exists(full) and os.path.exists(os.path.join(top, path)):
    full = os.path.join(top, path)
rel = os.path.relpath(full, top) if full.startswith(top + os.sep) else re.sub(r"^\./", "", path)
side = "LEFT" if old else "RIGHT"
rec = {"id": f"a{time.time_ns()}", "path": rel, "side": side, "line": end,
       "startSide": side if start != end else None, "startLine": start if start != end else None,
       "body": body, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
with open(os.path.join(gitdir, "herdr-review-inbox.jsonl"), "a") as f:
    f.write(json.dumps(rec) + "\n")
print(f"Draft saved for {rel}:{rng}{' (old)' if old else ''}. The reviewer decides whether to post it.")
