{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    18,
    23
  ],
  "background": "canvas",
  "padding": [
    4,
    6
  ],
  "gap": 8,
  "floating": [
    {
      "id": "zellij-nav",
      "content": {
        "mod": "zellij-nav"
      },
      "edge": "bottom",
      "align": "end"
    },
    {
      "id": "agent-notify",
      "content": {
        "mod": "agent-notify"
      },
      "edge": "bottom",
      "align": "start"
    },
    {
      "id": "agent-reader",
      "content": {
        "mod": "agent-reader"
      },
      "edge": "bottom",
      "align": "center"
    }
  ],
  "children": [
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "header": {
            "content": {
              "mod": "mine-pane"
            },
            "height": 38
          },
          "background": "background",
          "border": {
            "width": 1.5,
            "color": "background"
          },
          "focus": {
            "width": 1.5,
            "color": "accent"
          },
          "radius": 14,
          "gap": 10,
          "lone": true
        }
      }
    },
    {
      "id": "bottom",
      "type": "row",
      "size": {
        "px": 32
      },
      "gap": 8,
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "window_drag": true,
          "content": {
            "mod": "mine-bar"
          }
        },
        {
          "id": "ram",
          "type": "block",
          "size": {
            "px": 96
          },
          "window_drag": true,
          "content": {
            "mod": "mine-ram"
          }
        }
      ]
    }
  ]
}
